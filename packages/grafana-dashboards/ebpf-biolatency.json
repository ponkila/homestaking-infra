{
  "id": null,
  "uid": null,
  "title": "ebpf_exporter — Disk IO Latency (per-device percentiles)",
  "tags": ["ebpf", "disk", "latency"],
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "P50 Latency (per device / operation)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "id": 1,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, device, operation) ( rate(ebpf_exporter_bio_latency_seconds_bucket[5m]) ) )",
          "legendFormat": "{{device}} {{operation}} p50",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "P90 Latency (per device / operation)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "id": 2,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum by (le, device, operation) ( rate(ebpf_exporter_bio_latency_seconds_bucket[5m]) ) )",
          "legendFormat": "{{device}} {{operation}} p90",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "P95 Latency (per device / operation)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "id": 3,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, device, operation) ( rate(ebpf_exporter_bio_latency_seconds_bucket[5m]) ) )",
          "legendFormat": "{{device}} {{operation}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "P99 Latency (per device / operation)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "id": 4,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, device, operation) ( rate(ebpf_exporter_bio_latency_seconds_bucket[5m]) ) )",
          "legendFormat": "{{device}} {{operation}} p99",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Average Latency (per device / operation)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "id": 5,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (device, operation) ( rate(ebpf_exporter_bio_latency_seconds_sum[5m]) ) / sum by (device, operation) ( rate(ebpf_exporter_bio_latency_seconds_count[5m]) )",
          "legendFormat": "{{device}} {{operation}} avg",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "IOPS (requests/sec) per device / operation",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "id": 6,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (device, operation) ( rate(ebpf_exporter_bio_latency_seconds_count[5m]) ) ",
          "legendFormat": "{{device}} {{operation}} iops",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "heatmap",
      "title": "Latency Heatmap (distribution over time)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "id": 7,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (le, device) ( rate(ebpf_exporter_bio_latency_seconds_bucket[5m]) )",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "options": {
        "bucketSize": null,
        "color": { "mode": "spectrum" },
        "showLegend": true,
        "showXAxis": true,
        "showYAxis": true
      },
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "datasource": "${DS_PROMETHEUS}"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" }
}

